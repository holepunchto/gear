{
	"name": "gear",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:darwin": "bare-build --out build/darwin-arm64 --icon gear.png --host darwin-arm64 --runtime bare-native/runtime build/index.js",
		"build:android": "bare-build --out build/android-arm64 --host android-arm64 --resources resources/android --manifest manifest.xml --identifier io.gear.app --name Gear --runtime bare-native/runtime build/index.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"imports": {
		"process": {
			"bare": "bare-process",
			"default": "process"
		}
	},
	"dependencies": {
		"@humanspeak/svelte-markdown": "^1.4.1",
		"bare-crypto": "^1.13.4",
		"bare-fetch": "^2.8.2",
		"bare-form-data": "^1.0.0",
		"bare-fs": "^4.7.1",
		"bare-http1": "^4.5.6",
		"bare-module": "^6.2.0",
		"bare-native": "^0.1.2",
		"bare-process": "^4.4.1",
		"bare-storage": "^1.1.0",
		"bare-stream": "^2.9.1",
		"bare-url": "^2.4.2",
		"gip-transport": "^1.8.0",
		"hypercore-id-encoding": "^1.3.0",
		"paparam": "^1.10.1",
		"which-runtime": "^1.3.2"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^25.6.0",
		"bare-build": "^0.5.3",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"sveltekit-adapter-bare": "^0.1.4",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	}
}
