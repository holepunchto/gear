{
	"name": "gear",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"ota": "node scripts/ota.js",
		"mirror": "node scripts/mirror.js",
		"backfill": "node scripts/backfill.js",
		"dev": "vite dev",
		"build": "vite build",
		"release": "bare scripts/release.js",
		"make:darwin-arm64": "bare scripts/release.js --darwin-arm64 --unsigned",
		"make:android-arm64": "bare scripts/release.js --android-arm64",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test": "brittle-bare src/lib/server/releases/test.js src/lib/server/releases/test-store.js src/lib/server/releases/test-publishes.js src/lib/server/test-tags.js src/lib/server/test-newer-tags.js src/lib/server/test-release-names.js src/lib/test-release-flow.js",
		"postinstall": "patch-package"
	},
	"imports": {
		"process": {
			"bare": "bare-process",
			"default": "process"
		},
		"path": {
			"bare": "bare-path",
			"default": "path"
		},
		"fs": {
			"bare": "bare-fs",
			"default": "fs"
		},
		"crypto": {
			"bare": "bare-crypto",
			"default": "crypto"
		},
		"child_process": {
			"bare": "bare-subprocess",
			"default": "child_process"
		}
	},
	"dependencies": {
		"b4a": "^1.9.0",
		"bare-apk": "^0.2.0",
		"bare-console": "^6.2.0",
		"bare-crypto": "^1.13.7",
		"bare-fetch": "^3.5.0",
		"bare-fs": "^4.8.5",
		"bare-http1": "^4.5.6",
		"bare-module": "^7.5.2",
		"bare-native": "^0.3.8",
		"bare-navigation-android": "^0.1.0",
		"bare-path": "^3.1.0",
		"bare-process": "^4.5.1",
		"bare-storage": "^1.1.1",
		"bare-stream": "^2.13.4",
		"bare-subprocess": "^6.1.0",
		"bare-url": "^2.5.8",
		"blind-peering": "^2.6.1",
		"compact-encoding": "^3.7.0",
		"gear-ota": "file:ota",
		"gip-remote": "^2.3.0",
		"gip-transport": "^3.1.0",
		"highlight.js": "11.12.0",
		"hyper-multisig": "^2.5.0",
		"hyperbee2": "^2.11.0",
		"hyperconf": "^1.0.3",
		"hypercore-crypto": "^3.7.0",
		"hypercore-id-encoding": "^1.3.0",
		"hypercore-sign-lib": "^1.1.0",
		"hypercore-signing-request": "^5.2.0",
		"hyperdb": "^6.8.0",
		"node-emoji": "^2.2.0",
		"protomux-wakeup": "^2.9.0",
		"ready-resource": "^1.2.0",
		"sodium-native": "^5.1.0",
		"which-runtime": "^1.3.2",
		"z32": "^1.1.0"
	},
	"devDependencies": {
		"@humanspeak/svelte-markdown": "^1.4.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^25.6.0",
		"bare-build": "^1.7.0",
		"brittle": "^4.5.0",
		"conventional-commits-parser": "^6.4.0",
		"corestore": "^7.12.0",
		"hyperdht": "^6.36.0",
		"hyperschema": "^1.22.0",
		"hyperswarm": "^4.17.0",
		"paparam": "^1.10.1",
		"patch-package": "^8.0.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"sveltekit-adapter-bare": "github:holepunchto/sveltekit-adapter-bare#4ff0106cf5093c0871f86ba906b01d5b3730e1d6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	},
	"overrides": {
		"gip-remote": "$gip-remote",
		"bare-ndk": "0.3.5",
		"bare-type": "~1.4.0"
	}
}
